# Copy to .env.local for development. Production values live in Vercel.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, read only when the publishable key is unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (notify-seller, moderation emails, demo seed). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Production-only; leave unset locally and every send is skipped quietly.
RESEND_API_KEY=
# Sender for every outbound email. The domain must be verified in Resend
# (notify.indieops.co — DKIM / SPF / MX / DMARC at SiteGround, see
# docs/fiveup-continuation-phaseA.md). Defaults to
# "ProofSignals <noreply@notify.indieops.co>" when unset.
RESEND_FROM="ProofSignals <noreply@notify.indieops.co>"

# ── Discord (Phase A match-surface gate) ────────────────────────────────────
# Where /browse and /account/preferences send members while the
# plan_feature_gates 'match_surface' row is {"surface":"discord"}. When unset
# those routes fall back to /dashboard, which shows a "matching happens in
# Discord" notice without a join button.
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/<invite-code>

# ── Optional ────────────────────────────────────────────────────────────────
# AI Asset Builder (src/app/api/asset-builder).
ANTHROPIC_API_KEY=
# seed-demo.mjs only.
DEMO_SEED_PASSWORD=
